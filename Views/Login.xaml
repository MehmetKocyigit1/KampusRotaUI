<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KampusRotaUI.Views.Login"
             BackgroundColor="{StaticResource RideSurface}"
             Title="Giriş Yap">

    <ScrollView>
        <VerticalStackLayout Spacing="22" Padding="28,56,28,30">

            <VerticalStackLayout Spacing="6">
                <Label Text="KampüsRota" FontSize="36" FontAttributes="Bold" TextColor="{StaticResource Tertiary}" HorizontalOptions="Center" />
                <Label Text="Güvenli kampüs yolculuklarına devam et." FontSize="15" TextColor="{StaticResource RideMuted}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border Padding="22"
                    BackgroundColor="{StaticResource White}"
                    Stroke="{StaticResource RideLine}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="16">

                    <Border Stroke="{StaticResource RideLine}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Padding="12,0" >
                        <Entry x:Name="EmailEntry" Placeholder="Üniversite e-postası (.edu.tr)" Keyboard="Email" TextColor="{StaticResource Tertiary}" />
                    </Border>

                    <Border Stroke="{StaticResource RideLine}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Padding="12,0" >
                        <Entry x:Name="PasswordEntry" Placeholder="Şifre" IsPassword="True" TextColor="{StaticResource Tertiary}" />
                    </Border>

                    <Label x:Name="ErrorLabel" TextColor="#D93025" FontSize="12" IsVisible="False" />

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <CheckBox x:Name="RememberMeCheck" Color="{StaticResource Primary}" />
                        <Label Text="Beni hatırla" VerticalOptions="Center" TextColor="{StaticResource Tertiary}" />
                    </HorizontalStackLayout>

                    <Button Text="Giriş yap" BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource White}" CornerRadius="24" FontAttributes="Bold" HeightRequest="50" Clicked="OnLoginClicked" />

                </VerticalStackLayout>
            </Border>

            <Button Text="Hesabın yok mu? Kayıt ol" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontAttributes="Bold" Clicked="OnRegisterNavClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
