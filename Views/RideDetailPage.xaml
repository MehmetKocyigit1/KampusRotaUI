<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KampusRotaUI.Views.RideDetailPage"
             Title="İlan Detayı"
             NavigationPage.HasNavigationBar="False"
             Background="{StaticResource AppBackgroundBrush}">

    <ScrollView>
        <VerticalStackLayout Padding="18,18,18,28" Spacing="14">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Text="Geri"
                        Clicked="OnBackClicked"
                        BackgroundColor="#EAF6FD"
                        BorderColor="#BDDDED"
                        BorderWidth="1"
                        TextColor="#111827"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        Padding="16,0"
                        HeightRequest="40" />
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label Text="Yolculuk detayı" FontSize="22" FontAttributes="Bold" TextColor="#1D9DE5" />
                    <Label Text="Sürücüyle iletişime geç ve talep gönder." FontSize="12" TextColor="#6B7280" />
                </VerticalStackLayout>
            </Grid>

            <!-- Route preview -->
            <Border BackgroundColor="#1D9DE5" Stroke="Transparent" StrokeShape="RoundRectangle 20" Padding="18">
                <Grid ColumnDefinitions="22,*" ColumnSpacing="12">
                    <Grid RowDefinitions="16,*,16" WidthRequest="22">
                        <Border Grid.Row="0" BackgroundColor="#D6EEFB" Stroke="White" StrokeThickness="2" StrokeShape="RoundRectangle 8" HeightRequest="16" WidthRequest="16" HorizontalOptions="Center" />
                        <BoxView Grid.Row="1" WidthRequest="2" BackgroundColor="#80FFFFFF" HorizontalOptions="Center" />
                        <Border Grid.Row="2" BackgroundColor="#EF4444" Stroke="White" StrokeThickness="2" StrokeShape="RoundRectangle 8" HeightRequest="16" WidthRequest="16" HorizontalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout Grid.Column="1" Spacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="GÜZERGAH" FontSize="10" TextColor="#D6EEFB" FontAttributes="Bold" />
                            <Label x:Name="RouteLabel" FontSize="23" FontAttributes="Bold" TextColor="White" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Label x:Name="DateLabel" FontSize="13" TextColor="#D6EEFB" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Metrics -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Border BackgroundColor="#EAF6FD" Stroke="#BDDDED" StrokeShape="RoundRectangle 16" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Ücret" FontSize="11" TextColor="#6B7280" FontAttributes="Bold" />
                        <Label x:Name="PriceLabel" FontSize="19" FontAttributes="Bold" TextColor="#1D9DE5" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="#EAF6FD" Stroke="#BDDDED" StrokeShape="RoundRectangle 16" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Boş koltuk" FontSize="11" TextColor="#6B7280" FontAttributes="Bold" />
                        <Label x:Name="SeatLabel" FontSize="19" FontAttributes="Bold" TextColor="#1D9DE5" />
                    </VerticalStackLayout>
                </Border>
                <Border x:Name="WomenOnlyBadge" Grid.Row="1" Grid.ColumnSpan="2" BackgroundColor="#F4ECFA" Stroke="Transparent" StrokeShape="RoundRectangle 14" Padding="12,9" IsVisible="False">
                    <Label Text="Sadece kadın yolcular için" TextColor="#7B3FA0" FontAttributes="Bold" FontSize="13" />
                </Border>
            </Grid>

            <!-- Driver card -->
            <Border BackgroundColor="#EAF6FD" Stroke="#BDDDED" StrokeShape="RoundRectangle 18" Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="SÜRÜCÜ HAKKINDA" FontSize="11" FontAttributes="Bold" TextColor="#74777D" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="3">
                            <Label x:Name="DriverNameLabel" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                            <HorizontalStackLayout Spacing="7">
                                <Label x:Name="DriverStarsLabel" FontSize="15" TextColor="#F59E0B" VerticalOptions="Center" />
                                <Label x:Name="DriverRatingLabel" FontSize="13" TextColor="#4B5563" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <Border Grid.Column="1" BackgroundColor="#D6EEFB" Stroke="Transparent" StrokeShape="RoundRectangle 14" Padding="10,7" VerticalOptions="Center">
                            <Label Text="Güvenilir" TextColor="#1D9DE5" FontSize="11" FontAttributes="Bold" />
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#CFEAFF" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="İletişim" FontSize="13" FontAttributes="Bold" TextColor="#111827" />
                        <Label x:Name="DriverEmailLabel" FontSize="13" TextColor="#4B5563" LineBreakMode="TailTruncation" />
                        <Label x:Name="DriverPhoneLabel" FontSize="13" TextColor="#4B5563" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Notes -->
            <Border x:Name="DescriptionBlock" BackgroundColor="#EAF6FD" Stroke="#BDDDED" StrokeShape="RoundRectangle 18" Padding="16" IsVisible="False">
                <VerticalStackLayout Spacing="7">
                    <Label Text="Yolculuk açıklaması" FontSize="13" FontAttributes="Bold" TextColor="#111827" />
                    <Label x:Name="DescriptionLabel" FontSize="13" TextColor="#4B5563" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Telefonla ara"
                        Clicked="OnCallClicked"
                        BackgroundColor="#EAF6FD"
                        BorderColor="#BDDDED"
                        BorderWidth="1"
                        TextColor="#111827"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        HeightRequest="48" />
                <Button Grid.Column="1"
                        Text="Okul e-postası"
                        Clicked="OnEmailClicked"
                        BackgroundColor="#EAF6FD"
                        BorderColor="#BDDDED"
                        BorderWidth="1"
                        TextColor="#111827"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        HeightRequest="48" />
            </Grid>

            <Button x:Name="JoinButton"
                    Text="Katılma talebi gönder"
                    Clicked="OnJoinClicked"
                    BackgroundColor="#1D9DE5"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="18"
                    HeightRequest="54" />

            <Label Text="Talep gönderildiğinde sürücüyle telefon veya okul e-postası üzerinden iletişime geçebilirsin."
                   FontSize="11"
                   TextColor="#6B7280"
                   HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>


