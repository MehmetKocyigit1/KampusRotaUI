<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KampusRotaUI.Views.AddRidePage"
             Title="Yeni Yolculuk İlanı"
             BackgroundColor="#F4F6F8">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">

            <Frame HasShadow="True" CornerRadius="15" Padding="20" BorderColor="Transparent">
                <VerticalStackLayout Spacing="15">

                    <Label Text="Rota Bilgileri" FontAttributes="Bold" FontSize="18" TextColor="#2C3E50"/>

                    <Border Stroke="#BDC3C7" StrokeThickness="1" BackgroundColor="#F8F9F9">
                        <Picker x:Name="DeparturePicker" Title="Kalkış Noktası Seçin" Margin="10,0" TitleColor="Gray" TextColor="Black">
                            <Picker.Items>
                                <x:String>Iyaş</x:String>
                                <x:String>Doğu Kampüsü</x:String>
                                <x:String>Batı Kampüsü</x:String>
                                <x:String>100. Yıl Yerleşkesi</x:String>
                                <x:String>Otogar</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>

                    <Border Stroke="#BDC3C7" StrokeThickness="1" BackgroundColor="#F8F9F9">
                        <Picker x:Name="DestinationPicker" Title="Varış Noktası Seçin" Margin="10,0" TitleColor="Gray" TextColor="Black">
                            <Picker.Items>
                                <x:String>Batı Kampüsü</x:String>
                                <x:String>Doğu Kampüsü</x:String>
                                <x:String>Iyaş</x:String>
                                <x:String>Şehir Merkezi</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>

                    <Label Text="Zaman &amp; Detaylar" FontAttributes="Bold" FontSize="18" TextColor="#2C3E50" Margin="0,10,0,0" />

                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" ColumnSpacing="10" RowSpacing="5">
                        <Label Grid.Row="0" Grid.Column="0" Text="Tarih" FontAttributes="Bold" FontSize="14" TextColor="#2C3E50" />
                        <Label Grid.Row="0" Grid.Column="1" Text="Saat" FontAttributes="Bold" FontSize="14" TextColor="#2C3E50" />

                        <Border Grid.Row="1" Grid.Column="0" Stroke="#BDC3C7" StrokeThickness="1" BackgroundColor="#F8F9F9">
                            <DatePicker x:Name="RideDatePicker" Format="dd/MM/yyyy" TextColor="#2C3E50" Margin="10,0" HeightRequest="45"/>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Stroke="#BDC3C7" StrokeThickness="1" BackgroundColor="#F8F9F9">
                            <TimePicker x:Name="RideTimePicker" Format="HH:mm" TextColor="#2C3E50" Margin="10,0" HeightRequest="45"/>
                        </Border>
                    </Grid>

                    <!-- Koltuk ve Ücret (Yan Yana Grid Tasarımı) -->
                    <Grid RowDefinitions="Auto" ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,5,0,0">
                        <Border Grid.Column="0" Stroke="#BDC3C7" StrokeThickness="1" BackgroundColor="#F8F9F9">
                            <Entry x:Name="SeatsEntry" Placeholder="Koltuk Sayısı" Keyboard="Numeric" Margin="10,0" TextColor="Black" />
                        </Border>

                        <Border Grid.Column="1" Stroke="#BDC3C7" StrokeThickness="1" BackgroundColor="#F8F9F9">
                            <Entry x:Name="PriceEntry" Placeholder="Ücret (₺) (Opsiyonel)" Keyboard="Numeric" Margin="10,0" TextColor="Black" />
                        </Border>
                    </Grid>

                    <!-- Açıklama Alanı (Editor ile çok satırlı giriş) -->
                    <Border Stroke="#BDC3C7" StrokeThickness="1" BackgroundColor="#F8F9F9" Margin="0,5,0,0">
                        <Editor x:Name="DescriptionEditor" Placeholder="Açıklama (Örn: Sadece sabahçı grubu, bagaj boş...)" HeightRequest="80" Margin="10,0" TextColor="Black" />
                    </Border>

                    <!-- Kadınlara Özel Filtresi -->
                    <HorizontalStackLayout Spacing="10" Margin="0,5,0,0">
                        <CheckBox x:Name="WomenOnlyCheckBox" Color="#9B59B6" />
                        <Label Text="👩 Sadece Kadınlar" VerticalOptions="Center" FontSize="14" TextColor="#2C3E50" FontAttributes="Bold"/>
                    </HorizontalStackLayout>

                    <!-- Araya ince bir çizgi (Ayırıcı) -->
                    <BoxView HeightRequest="1" Color="#E5E7E9" Margin="0,10" />

                    <!-- Kurallar -->
                    <HorizontalStackLayout Spacing="10">
                        <CheckBox x:Name="TermsCheckBox" Color="#3498DB" />
                        <Label Text="Kampüs kurallarına uymayı kabul ediyorum." VerticalOptions="Center" FontSize="12" TextColor="#7F8C8D"/>
                    </HorizontalStackLayout>

                    <Button Text="İlanı Yayınla" Clicked="OnPublishClicked" BackgroundColor="#2ECC71" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="50" Margin="0,10,0,0" />

                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>