<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KampusRotaUI.Views.AddRidePage"
             Title="Yeni Yolculuk İlanı"
             NavigationPage.HasNavigationBar="False"
             Background="{StaticResource AppBackgroundBrush}">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="20,18,20,28">

            <VerticalStackLayout Spacing="4">
                <Label Text="Yolculuk yayınla" FontAttributes="Bold" FontSize="28" TextColor="White" />
                <Label Text="Güzergahı ve koltuk detaylarını net yaz, doğru yolcular seni bulsun." FontSize="13" TextColor="White" />
            </VerticalStackLayout>

            <Border Padding="20"   Stroke="White" StrokeThickness="1" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="16">

                    <Label Text="Rota bilgileri" FontAttributes="Bold" FontSize="18" TextColor="White"/>

                    <Border Stroke="White" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Padding="12,0">
                        <Picker x:Name="DeparturePicker" Title="Kalkış noktası seçin" TitleColor="#777" TextColor="#2C3E50">
                            <Picker.Items>
                                <x:String>Iyaş</x:String>
                                <x:String>Doğu Kampüsü</x:String>
                                <x:String>Batı Kampüsü</x:String>
                                <x:String>100. Yıl Yerleşkesi</x:String>
                                <x:String>Erkek Yurdu</x:String>
                                <x:String>MihriHatun Kız Yurdu</x:String>
                                <x:String>Şehir Merkezi (Meydan)</x:String>
                                <x:String>Otogar</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>

                    <Border Stroke="White" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Padding="12,0">
                        <Picker x:Name="DestinationPicker" Title="Varış noktası seçin" TitleColor="#777" TextColor="#2C3E50">
                            <Picker.Items>
                                <x:String>Iyaş</x:String>
                                <x:String>Doğu Kampüsü</x:String>
                                <x:String>Batı Kampüsü</x:String>
                                <x:String>100. Yıl Yerleşkesi</x:String>
                                <x:String>Erkek Yurdu</x:String>
                                <x:String>MihriHatun Kız Yurdu</x:String>
                                <x:String>Şehir Merkezi (Meydan)</x:String>
                                <x:String>Otogar</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>

                    <Label Text="Zaman ve detaylar" FontAttributes="Bold" FontSize="18" TextColor="White" Margin="0,10,0,0" />

                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" ColumnSpacing="10" RowSpacing="5">
                        <Label Grid.Row="0" Grid.Column="0" Text="Tarih" FontAttributes="Bold" FontSize="13" TextColor="#777" />
                        <Label Grid.Row="0" Grid.Column="1" Text="Saat" FontAttributes="Bold" FontSize="13" TextColor="#777" />

                        <Border Grid.Row="1" Grid.Column="0" Stroke="White" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Padding="12,0">
                            <DatePicker x:Name="RideDatePicker" Format="dd/MM/yyyy" TextColor="#2C3E50" HeightRequest="45"/>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Stroke="White" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Padding="12,0">
                            <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center">
                                <Label Text="🕒" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center" Margin="0,0,-70,0" />
                                <TimePicker x:Name="RideTimePicker" Format="HH:mm" TextColor="#2C3E50" HeightRequest="45" BackgroundColor="Transparent" HorizontalOptions="Fill" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Koltuk ve Ücret (Yan Yana Grid Tasarımı) -->
                    <Grid RowDefinitions="Auto" ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,5,0,0">
                        <Border Grid.Column="0" Stroke="White" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Padding="12,0">
                            <Entry x:Name="SeatsEntry" Placeholder="Koltuk sayısı" Keyboard="Numeric" TextColor="Black" PlaceholderColor="Gray"/>
                        </Border>

                        <Border Grid.Column="1" Stroke="White" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Padding="12,0">
                            <Entry x:Name="PriceEntry" Placeholder="Ücret (opsiyonel)" Keyboard="Numeric" TextColor="Black" PlaceholderColor="Gray"/>
                        </Border>
                    </Grid>

                    <!-- Açıklama Alanı (Editor ile çok satırlı giriş) -->
                    <Border Stroke="White" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Margin="0,5,0,0" Padding="12,6">
                        <Editor x:Name="DescriptionEditor" Placeholder="Açıklama: buluşma noktası, bagaj, notlar..." HeightRequest="82" TextColor="Black" PlaceholderColor="Gray" />
                    </Border>

                    <!-- Kadınlara Özel Filtresi -->
                    <HorizontalStackLayout Spacing="10" Margin="0,5,0,0">
                        <CheckBox x:Name="WomenOnlyCheckBox" Color="White" />
                        <Label Text="Sadece kadınlar" VerticalOptions="Center" FontSize="14" TextColor="White" FontAttributes="Bold" TranslationX="-15"/>
                    </HorizontalStackLayout>

                    <!-- Araya ince bir çizgi (Ayırıcı) -->
                    <BoxView HeightRequest="1" Color="White" Margin="0,10" />

                    <!-- Kurallar -->
                    <HorizontalStackLayout Spacing="10">
                        <CheckBox x:Name="TermsCheckBox" Color="White" />
                        <Label Text="Kampüs kurallarına uymayı kabul ediyorum." VerticalOptions="Center" FontSize="12" TextColor="White" TranslationX="-15"/>
                    </HorizontalStackLayout>

                    <Button Text="İlanı yayınla" Clicked="OnPublishClicked" BackgroundColor="White" TextColor="#000" FontAttributes="Bold" CornerRadius="24" HeightRequest="50" Margin="0,10,0,0" />

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
