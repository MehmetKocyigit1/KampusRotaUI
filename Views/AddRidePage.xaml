<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KampusRotaUI.Views.AddRidePage"
             Title="Yeni Yolculuk İlanı"
             NavigationPage.HasNavigationBar="False"
             Background="{StaticResource AppBackgroundBrush}">

    <Grid RowDefinitions="*" x:Name="MainGrid">

        <ScrollView x:Name="FormView" Grid.Row="0" IsVisible="True">
            <VerticalStackLayout Spacing="16" Padding="18,20,18,28">

                <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                    <Border BackgroundColor="#1D9DE5" Stroke="Transparent" StrokeShape="RoundRectangle 14" HeightRequest="42" WidthRequest="42">
                        <Label Text="+" TextColor="#D6EEFB" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Yolculuk ilanı ver" FontSize="25" FontAttributes="Bold" TextColor="#1D9DE5" />
                        <Label Text="Kampüs arkadaşlarınla yolculuğunu paylaş." FontSize="12" TextColor="#6B7280" />
                    </VerticalStackLayout>
                </Grid>

                <Border BackgroundColor="#EAF6FD" Stroke="#BDDDED" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16">
                    <VerticalStackLayout Spacing="14">

                        <Label Text="Rota bilgileri" FontSize="12" FontAttributes="Bold" TextColor="#74777D" />

                        <Border Stroke="#BDDDED" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#EAF6FD" Padding="12,0" HeightRequest="52">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDepartureLocationTapped" />
                            </Border.GestureRecognizers>
                            <Grid VerticalOptions="Center">
                                <Label x:Name="DepartureLocationLabel" Text="Kalkış noktası seçin" FontSize="14" TextColor="#6B7280" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                <Picker x:Name="DeparturePicker" IsVisible="False">
                                    <Picker.Items>
                                        <x:String>Iyaş</x:String>
                                        <x:String>Doğu Kampüsü</x:String>
                                        <x:String>Batı Kampüsü</x:String>
                                        <x:String>100. Yıl Yerleşkesi</x:String>
                                        <x:String>Erkek Yurdu</x:String>
                                        <x:String>MihriHatun Kız Yurdu</x:String>
                                        <x:String>Şehir Merkezi (Meydan)</x:String>
                                        <x:String>Otogar</x:String>
                                    </Picker.Items>
                                </Picker>
                            </Grid>
                        </Border>

                        <Border Stroke="#BDDDED" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#EAF6FD" Padding="12,0" HeightRequest="52">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDestinationLocationTapped" />
                            </Border.GestureRecognizers>
                            <Grid VerticalOptions="Center">
                                <Label x:Name="DestinationLocationLabel" Text="Varış noktası seçin" FontSize="14" TextColor="#6B7280" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                <Picker x:Name="DestinationPicker" IsVisible="False">
                                    <Picker.Items>
                                        <x:String>Iyaş</x:String>
                                        <x:String>Doğu Kampüsü</x:String>
                                        <x:String>Batı Kampüsü</x:String>
                                        <x:String>100. Yıl Yerleşkesi</x:String>
                                        <x:String>Erkek Yurdu</x:String>
                                        <x:String>MihriHatun Kız Yurdu</x:String>
                                        <x:String>Şehir Merkezi (Meydan)</x:String>
                                        <x:String>Otogar</x:String>
                                    </Picker.Items>
                                </Picker>
                            </Grid>
                        </Border>

                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="6">
                            <Label Text="Tarih" FontSize="12" FontAttributes="Bold" TextColor="#74777D" />
                            <Label Grid.Column="1" Text="Saat" FontSize="12" FontAttributes="Bold" TextColor="#74777D" />

                            <Border Grid.Row="1" Stroke="#BDDDED" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#EAF6FD" Padding="12,0" HeightRequest="52">
                                <DatePicker x:Name="RideDatePicker" Format="dd/MM/yyyy" TextColor="#111827" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Stroke="#BDDDED" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#EAF6FD" Padding="12,0" HeightRequest="52">
                                <TimePicker x:Name="RideTimePicker" Format="HH:mm" TextColor="#111827" BackgroundColor="Transparent" />
                            </Border>
                        </Grid>

                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="6">
                            <Label Text="Ücret" FontSize="12" FontAttributes="Bold" TextColor="#74777D" />
                            <Label Grid.Column="1" Text="Koltuk" FontSize="12" FontAttributes="Bold" TextColor="#74777D" />

                            <Border Grid.Row="1" Stroke="#BDDDED" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#EAF6FD" Padding="12,0" HeightRequest="52">
                                <Entry x:Name="PriceEntry" Placeholder="0 TL" Keyboard="Numeric" TextColor="#111827" PlaceholderColor="#9CA3AF" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Stroke="#BDDDED" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#EAF6FD" Padding="12,0" HeightRequest="52">
                                <Entry x:Name="SeatsEntry" Placeholder="1-6" Keyboard="Numeric" TextColor="#111827" PlaceholderColor="#9CA3AF" />
                            </Border>
                        </Grid>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Açıklama / Kurallar" FontSize="12" FontAttributes="Bold" TextColor="#74777D" />
                            <Border Stroke="#BDDDED" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#EAF6FD" Padding="12,8">
                                <Editor x:Name="DescriptionEditor" Placeholder="Buluşma noktası, bagaj, notlar..." HeightRequest="90" TextColor="#111827" PlaceholderColor="#9CA3AF" />
                            </Border>
                        </VerticalStackLayout>

                        <Border BackgroundColor="#EAF6FD" Stroke="#BDDDED" StrokeShape="RoundRectangle 14" Padding="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <CheckBox x:Name="WomenOnlyCheckBox" Color="#1D9DE5" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="Sadece kadınlar" FontSize="13" FontAttributes="Bold" TextColor="#111827" />
                                    <Label Text="İlanı kadın yolcular için görünür yap." FontSize="11" TextColor="#6B7280" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Border BackgroundColor="#EAF6FD" Stroke="#BDDDED" StrokeShape="RoundRectangle 14" Padding="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <CheckBox x:Name="TermsCheckBox" Color="#1D9DE5" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Kampüs kurallarına uymayı kabul ediyorum." FontSize="12" TextColor="#374151" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Button Text="İlanı yayınla"
                                Clicked="OnPublishClicked"
                                BackgroundColor="#1D9DE5"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="18"
                                HeightRequest="54"
                                Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="MapContainer" Grid.Row="0" IsVisible="False">
            <WebView x:Name="MapWebView" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" />
            <Button Text="Kapat"
                    Clicked="OnCloseMapClicked"
                    BackgroundColor="#EAF6FD"
                    TextColor="#111827"
                    FontAttributes="Bold"
                    CornerRadius="18"
                    Padding="18,0"
                    HeightRequest="40"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0,16,16,0" />
            <Label x:Name="MapDebugLabel" TextColor="White" BackgroundColor="#66000000" Margin="10" VerticalOptions="Start" HorizontalOptions="Fill" IsVisible="False" />
        </Grid>

    </Grid>
</ContentPage>


