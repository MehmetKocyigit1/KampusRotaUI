<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KampusRotaUI.Views.ProfilePage"
             Title="Profilim"
             BackgroundColor="#F4F6F8">

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Start">

            <!-- Profil Fotoğrafı Alanı -->
            <Frame HasShadow="True" 
                   CornerRadius="60" 
                   HeightRequest="120" 
                   WidthRequest="120" 
                   HorizontalOptions="Center" 
                   Padding="0"
                   BorderColor="#3498DB">
                <Image Source="dotnet_bot.png" 
                       Aspect="AspectFill" 
                       BackgroundColor="#EAECEE"/>
            </Frame>

            <!-- Kullanıcı Bilgileri Kartı -->
            <Frame HasShadow="True" CornerRadius="15" Padding="20" BackgroundColor="White" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label x:Name="NameLabel" 
                           FontSize="22" 
                           FontAttributes="Bold" 
                           TextColor="#2C3E50" 
                           HorizontalOptions="Center" />

                    <Label x:Name="EmailLabel" 
                           FontSize="16" 
                           TextColor="#7F8C8D" 
                           HorizontalOptions="Center" />

                    <BoxView HeightRequest="1" Color="#DCDDE1" Margin="0,10" />

                    <Label Text="Üniversite Doğrulanmış Hesap" 
                           TextColor="#27AE60" 
                           FontSize="12" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <!-- İstatistik veya Ekstra Bilgi (Opsiyonel) -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                <Frame Grid.Column="0" HasShadow="False" CornerRadius="10" BackgroundColor="#EBF5FB">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="Yolculuklar" FontSize="12" TextColor="#3498DB" HorizontalOptions="Center"/>
                        <Label Text="0" FontAttributes="Bold" FontSize="18" TextColor="#2C3E50" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Column="1" HasShadow="False" CornerRadius="10" BackgroundColor="#EBF5FB">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="Puanım" FontSize="12" TextColor="#3498DB" HorizontalOptions="Center"/>
                        <Label Text="5.0" FontAttributes="Bold" FontSize="18" TextColor="#2C3E50" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Çıkış Butonu -->
            <Button Text="Güvenli Çıkış Yap" 
                    Clicked="OnLogoutClicked" 
                    BackgroundColor="#E74C3C" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    CornerRadius="10" 
                    HeightRequest="50" 
                    Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>