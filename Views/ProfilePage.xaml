<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KampusRotaUI.Views.ProfilePage"
             Title="Profilim"
             NavigationPage.HasNavigationBar="False"
             Background="{StaticResource AppBackgroundBrush}">

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0,0,0,28">

            <!-- Top bar -->
            <Grid ColumnDefinitions="*,Auto" Padding="18,14" BackgroundColor="#EAF6FD">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Border BackgroundColor="Transparent" Stroke="Transparent" StrokeShape="RoundRectangle 14" HeightRequest="44" WidthRequest="44">
                        <Image Source="kampusrota_logo.png" Aspect="AspectFit" />
                    </Border>
                    <Label Text="KampüsRota" FontSize="21" FontAttributes="Bold" TextColor="#1D9DE5" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border Grid.Column="1" Stroke="#D6EEFB" StrokeThickness="2" StrokeShape="RoundRectangle 22" HeightRequest="44" WidthRequest="44">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAddPhotoTapped" />
                    </Border.GestureRecognizers>
                    <Image x:Name="HeaderProfileImage" Source="insta_male.png" Aspect="AspectFill" />
                </Border>
            </Grid>

            <!-- Profile hero -->
            <Grid Padding="20,28,20,42">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1D9DE5" Offset="0.0" />
                        <GradientStop Color="#6EC8F4" Offset="1.0" />
                    </LinearGradientBrush>
                </Grid.Background>

                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Grid HeightRequest="108" WidthRequest="108">
                        <Border Stroke="White" StrokeThickness="4" StrokeShape="RoundRectangle 54" BackgroundColor="#EAF6FD">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAddPhotoTapped" />
                            </Border.GestureRecognizers>
                            <Image x:Name="ProfileImage" Source="insta_male.png" Aspect="AspectFill" />
                        </Border>

                        <Border BackgroundColor="#1D9DE5"
                                Stroke="#1D9DE5"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 16"
                                HeightRequest="32"
                                WidthRequest="32"
                                HorizontalOptions="End"
                                VerticalOptions="End">
                            <Label Text="✓" TextColor="White" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <Label x:Name="NameLabel" TextColor="White" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label x:Name="EmailLabel" TextColor="#D6EEFB" FontSize="14" HorizontalOptions="Center" />

                    <Border BackgroundColor="#33FFFFFF" Stroke="Transparent" StrokeShape="RoundRectangle 18" Padding="12,6">
                        <HorizontalStackLayout Spacing="6">
                            <Label x:Name="RatingStarsLabel" Text="★★★★★" TextColor="#FFB95F" FontSize="14" VerticalOptions="Center" />
                            <Label x:Name="RatingLabel" Text="5.0" TextColor="White" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Text="Puan" TextColor="White" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <Label x:Name="BioLabel"
                           TextColor="#E6FFFFFF"
                           FontSize="13"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           MaxLines="3"
                           Margin="10,0"
                           IsVisible="False" />
                </VerticalStackLayout>
            </Grid>

            <!-- Stats -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Padding="18,0" Margin="0,-24,0,0">
                <Border BackgroundColor="#EAF6FD" Stroke="#BDDDED" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="16">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                        <Label x:Name="RideCountLabel" Text="0" FontSize="22" FontAttributes="Bold" TextColor="#1D9DE5" HorizontalOptions="Center" />
                        <Label Text="Yolculuk Sayısı" FontSize="12" TextColor="#44474C" FontAttributes="Bold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" BackgroundColor="#EAF6FD" Stroke="#BDDDED" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="16">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                        <Label Text="Aktif" FontSize="22" FontAttributes="Bold" TextColor="#1D9DE5" HorizontalOptions="Center" />
                        <Label Text="Üyelik Durumu" FontSize="12" TextColor="#44474C" FontAttributes="Bold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Profile summary -->
            <VerticalStackLayout Spacing="10" Padding="18,18,18,0">
                <Label Text="PROFİL ÖZETİ" FontSize="12" FontAttributes="Bold" TextColor="#74777D" Margin="4,0" />

                <Border BackgroundColor="#EAF6FD" Stroke="#BDDDED" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Profil tamamlanma" FontSize="12" FontAttributes="Bold" TextColor="#74777D" />
                                <ProgressBar x:Name="ProfileCompletionBar" Progress="0" ProgressColor="#1D9DE5" BackgroundColor="#D6EEFB" HeightRequest="8" />
                            </VerticalStackLayout>
                            <Label x:Name="ProfileCompletionLabel" Grid.Column="1" Text="0%" FontSize="13" FontAttributes="Bold" TextColor="#1D9DE5" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#CFEAFF" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Telefon" FontSize="12" FontAttributes="Bold" TextColor="#74777D" />
                                <Label x:Name="PhoneSummaryLabel" Text="Belirtilmemiş" FontSize="13" TextColor="#111827" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Cinsiyet" FontSize="12" FontAttributes="Bold" TextColor="#74777D" />
                                <Label x:Name="GenderSummaryLabel" Text="Belirtilmemiş" FontSize="13" TextColor="#111827" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Öğrenci numarası" FontSize="12" FontAttributes="Bold" TextColor="#74777D" />
                            <Label x:Name="StudentNoSummaryLabel" Text="Belirtilmemiş" FontSize="13" TextColor="#111827" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Account settings -->
            <VerticalStackLayout Spacing="10" Padding="18,24,18,0">
                <Label Text="HESAP AYARLARI" FontSize="12" FontAttributes="Bold" TextColor="#74777D" Margin="4,0" />

                <Border BackgroundColor="#EAF6FD" Stroke="#BDDDED" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="14" ColumnDefinitions="44,*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEditProfileClicked" />
                            </Grid.GestureRecognizers>
                            <Border BackgroundColor="#D6EEFB" Stroke="Transparent" StrokeShape="RoundRectangle 12" HeightRequest="40" WidthRequest="40">
                                <Label Text="🎓" TextColor="#1D9DE5" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Profili Düzenle" TextColor="#1B1C1C" FontSize="16" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" TextColor="#74777D" FontSize="28" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F0EDED" Margin="58,0,0,0" />

                        <Grid Padding="14" ColumnDefinitions="44,*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChangePasswordClicked" />
                            </Grid.GestureRecognizers>
                            <Border BackgroundColor="#EAE8E7" Stroke="Transparent" StrokeShape="RoundRectangle 12" HeightRequest="40" WidthRequest="40">
                                <Label Text="🔏" TextColor="#44474C" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Şifre Değiştir" TextColor="#1B1C1C" FontSize="16" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" TextColor="#74777D" FontSize="28" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F0EDED" Margin="58,0,0,0" />

                        <Grid Padding="14" ColumnDefinitions="44,*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNotificationSettingsClicked" />
                            </Grid.GestureRecognizers>
                            <Border BackgroundColor="#EAE8E7" Stroke="Transparent" StrokeShape="RoundRectangle 12" HeightRequest="40" WidthRequest="40">
                                <Label Text="🔔" TextColor="#44474C" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Bildirim Ayarları" TextColor="#1B1C1C" FontSize="16" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" TextColor="#74777D" FontSize="28" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Support -->
            <VerticalStackLayout Spacing="10" Padding="18,22,18,0">
                <Label Text="DESTEK" FontSize="12" FontAttributes="Bold" TextColor="#74777D" Margin="4,0" />

                <Border BackgroundColor="#EAF6FD" Stroke="#BDDDED" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                    <Grid Padding="14" ColumnDefinitions="44,*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHelpClicked" />
                        </Grid.GestureRecognizers>
                        <Border BackgroundColor="#EAE8E7" Stroke="Transparent" StrokeShape="RoundRectangle 12" HeightRequest="40" WidthRequest="40">
                            <Label Text="💬" TextColor="#44474C" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Yardım ve Destek" TextColor="#1B1C1C" FontSize="16" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" TextColor="#74777D" FontSize="28" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Destructive actions -->
            <VerticalStackLayout Spacing="10" Padding="18,24,18,0">
                <Button Text="Çıkış Yap"
                        BackgroundColor="#EAF6FD"
                        BorderColor="#FFDAD6"
                        BorderWidth="1"
                        TextColor="#EF4444"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        HeightRequest="50"
                        Clicked="OnLogoutClicked" />

                <Button Text="Hesabı Kalıcı Olarak Sil"
                        BackgroundColor="Transparent"
                        TextColor="#74777D"
                        FontSize="12"
                        FontAttributes="Bold"
                        Clicked="OnDeleteAccountClicked" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>


