<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KampusRotaUI.Views.ProfilePage"
             Title="Profilim"
             BackgroundColor="{StaticResource RideSurface}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="26,28,26,30" VerticalOptions="Start">

            <Border Padding="24"
                    BackgroundColor="{StaticResource White}"
                    Stroke="{StaticResource RideLine}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                    <Border HeightRequest="92"
                            WidthRequest="92"
                            HorizontalOptions="Center"
                            Stroke="{StaticResource Secondary}"
                            StrokeThickness="6"
                            StrokeShape="RoundRectangle 46"
                            BackgroundColor="{StaticResource Secondary}">
                        <Label Text="KR" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <Label x:Name="NameLabel" 
                           FontSize="23" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource Tertiary}" 
                           HorizontalOptions="Center" />

                    <Label x:Name="EmailLabel" 
                           FontSize="14" 
                           TextColor="{StaticResource RideMuted}" 
                           HorizontalOptions="Center" />

                    <BoxView HeightRequest="1" Color="{StaticResource RideLine}" Margin="0,8" />

                    <Label Text="Üniversite Doğrulanmış Hesap" 
                           TextColor="{StaticResource RideSuccess}" 
                           FontSize="12" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- İstatistik veya Ekstra Bilgi (Opsiyonel) -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                <Border Grid.Column="0" Padding="16" Stroke="{StaticResource RideLine}" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource White}">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="Yolculuklar" FontSize="12" TextColor="{StaticResource RideMuted}" HorizontalOptions="Center"/>
                        <Label Text="0" FontAttributes="Bold" FontSize="20" TextColor="{StaticResource Tertiary}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Padding="16" Stroke="{StaticResource RideLine}" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource White}">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="Puanım" FontSize="12" TextColor="{StaticResource RideMuted}" HorizontalOptions="Center"/>
                        <Label Text="5.0" FontAttributes="Bold" FontSize="20" TextColor="{StaticResource Tertiary}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Çıkış Butonu -->
            <Button Text="Güvenli çıkış yap" 
                    Clicked="OnLogoutClicked" 
                    BackgroundColor="#D93025" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    CornerRadius="24" 
                    HeightRequest="50" 
                    Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
