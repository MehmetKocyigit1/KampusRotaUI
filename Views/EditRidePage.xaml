<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KampusRotaUI.Views.EditRidePage"
             Title="İlanı Güncelle"
             BackgroundColor="{StaticResource RideSurface}">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="20,18,20,28">

            <VerticalStackLayout Spacing="4">
                <Label Text="Yolculuk ilanını güncelle" FontAttributes="Bold" FontSize="26" TextColor="{StaticResource Tertiary}" />
                <Label Text="Değişen rota, saat veya koltuk bilgilerini kaydet." FontSize="13" TextColor="{StaticResource RideMuted}" />
            </VerticalStackLayout>

            <Border Padding="20" BackgroundColor="{StaticResource White}" Stroke="{StaticResource RideLine}" StrokeThickness="1" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="16">

                    <Border Stroke="{StaticResource RideLine}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Padding="12,0">
                        <Picker x:Name="DeparturePicker" Title="Kalkış noktası" TitleColor="{StaticResource RideMuted}" TextColor="{StaticResource Tertiary}">
                            <Picker.Items>
                                <x:String>Iyaş</x:String>
                                <x:String>Doğu Kampüsü</x:String>
                                <x:String>Batı Kampüsü</x:String>
                                <x:String>100. Yıl Yerleşkesi</x:String>
                                <x:String>Erkek Yurdu</x:String>
                                <x:String>MihriHatun Kız Yurdu</x:String>
                                <x:String>Şehir Merkezi (Meydan)</x:String>
                                <x:String>Otogar</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>

                    <Border Stroke="{StaticResource RideLine}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Padding="12,0">
                        <Picker x:Name="DestinationPicker" Title="Varış noktası" TitleColor="{StaticResource RideMuted}" TextColor="{StaticResource Tertiary}">
                            <Picker.Items>
                                <x:String>Iyaş</x:String>
                                <x:String>Doğu Kampüsü</x:String>
                                <x:String>Batı Kampüsü</x:String>
                                <x:String>100. Yıl Yerleşkesi</x:String>
                                <x:String>Erkek Yurdu</x:String>
                                <x:String>MihriHatun Kız Yurdu</x:String>
                                <x:String>Şehir Merkezi (Meydan)</x:String>
                                <x:String>Otogar</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>

                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" ColumnSpacing="10" RowSpacing="5">
                        <Label Grid.Row="0" Grid.Column="0" Text="Tarih" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource RideMuted}" />
                        <Label Grid.Row="0" Grid.Column="1" Text="Saat" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource RideMuted}" />

                        <Border Grid.Row="1" Grid.Column="0" Stroke="{StaticResource RideLine}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Padding="12,0">
                            <DatePicker x:Name="RideDatePicker" Format="dd/MM/yyyy" TextColor="{StaticResource Tertiary}" HeightRequest="45"/>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Stroke="{StaticResource RideLine}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Padding="12,0">
                            <TimePicker x:Name="RideTimePicker" Format="HH:mm" TextColor="{StaticResource Tertiary}" HeightRequest="45"/>
                        </Border>
                    </Grid>

                    <Grid RowDefinitions="Auto" ColumnDefinitions="*, *" ColumnSpacing="10">
                        <Border Grid.Column="0" Stroke="{StaticResource RideLine}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Padding="12,0">
                            <Entry x:Name="SeatsEntry" Placeholder="Koltuk sayısı" Keyboard="Numeric" TextColor="{StaticResource Tertiary}" />
                        </Border>

                        <Border Grid.Column="1" Stroke="{StaticResource RideLine}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Padding="12,0">
                            <Entry x:Name="PriceEntry" Placeholder="Ücret" Keyboard="Numeric" TextColor="{StaticResource Tertiary}" />
                        </Border>
                    </Grid>

                    <Border Stroke="{StaticResource RideLine}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Padding="12,6">
                        <Editor x:Name="DescriptionEditor" Placeholder="Açıklama" HeightRequest="82" TextColor="{StaticResource Tertiary}" />
                    </Border>

                    <HorizontalStackLayout Spacing="10">
                        <CheckBox x:Name="WomenOnlyCheckBox" Color="#7B3FA0" />
                        <Label Text="Sadece kadınlar" VerticalOptions="Center" FontSize="14" TextColor="{StaticResource Tertiary}" FontAttributes="Bold"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <CheckBox x:Name="ActiveCheckBox" Color="{StaticResource Primary}" />
                        <Label Text="İlan aktif" VerticalOptions="Center" FontSize="14" TextColor="{StaticResource Tertiary}" FontAttributes="Bold"/>
                    </HorizontalStackLayout>

                    <Label x:Name="MessageLabel" FontSize="12" TextColor="#D93025" IsVisible="False" />

                    <Button Text="Değişiklikleri kaydet"
                            Clicked="OnSaveClicked"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            CornerRadius="24"
                            HeightRequest="50"
                            Margin="0,8,0,0" />

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
