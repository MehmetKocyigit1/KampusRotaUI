<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KampusRotaUI.Views.ChangePasswordPage"
             Title="Şifre Değiştir"
             NavigationPage.HasNavigationBar="False"
             Background="{StaticResource AppBackgroundBrush}">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="18,20,18,28">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
 
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label Text="Şifreyi değiştir" FontSize="23" FontAttributes="Bold" TextColor="#1D9DE5" />
                    <Label Text="Hesabının güvenliğini güncel tut." FontSize="12" TextColor="#6B7280" />
                </VerticalStackLayout>
            </Grid>

            <Border BackgroundColor="#1D9DE5" Stroke="Transparent" StrokeShape="RoundRectangle 22" Padding="22">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Border BackgroundColor="#6EC8F4" Stroke="Transparent" StrokeShape="RoundRectangle 32" HeightRequest="64" WidthRequest="64">
                        <Label Text="🔏" TextColor="#D6EEFB" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="Güvenlik ayarları" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                    <Label Text="Yeni şifren en az 6 karakter olmalı." FontSize="13" TextColor="#D6EEFB" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#EAF6FD" Stroke="#BDDDED" StrokeShape="RoundRectangle 18" Padding="16">
                <VerticalStackLayout Spacing="14">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Mevcut şifre" FontSize="12" FontAttributes="Bold" TextColor="#74777D" />
                        <Border Stroke="#BDDDED" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#EAF6FD" Padding="12,0" HeightRequest="52">
                            <Entry x:Name="OldPasswordEntry" Placeholder="Mevcut şifre" IsPassword="True" TextColor="#111827" PlaceholderColor="#9CA3AF" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Yeni şifre" FontSize="12" FontAttributes="Bold" TextColor="#74777D" />
                        <Border Stroke="#BDDDED" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#EAF6FD" Padding="12,0" HeightRequest="52">
                            <Entry x:Name="NewPasswordEntry" Placeholder="Yeni şifre" IsPassword="True" TextColor="#111827" PlaceholderColor="#9CA3AF" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Yeni şifre tekrar" FontSize="12" FontAttributes="Bold" TextColor="#74777D" />
                        <Border Stroke="#BDDDED" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#EAF6FD" Padding="12,0" HeightRequest="52">
                            <Entry x:Name="ConfirmPasswordEntry" Placeholder="Yeni şifre tekrar" IsPassword="True" TextColor="#111827" PlaceholderColor="#9CA3AF" />
                        </Border>
                    </VerticalStackLayout>

                    <Label x:Name="MessageLabel" FontSize="12" IsVisible="False" HorizontalOptions="Center" HorizontalTextAlignment="Center" />

                    <Button Text="Şifreyi güncelle"
                            BackgroundColor="#1D9DE5"
                            TextColor="White"
                            CornerRadius="18"
                            FontAttributes="Bold"
                            HeightRequest="54"
                            Margin="0,4,0,0"
                            Clicked="OnUpdatePasswordClicked" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>


