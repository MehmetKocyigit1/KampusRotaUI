<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KampusRotaUI.Views.ChangePasswordPage"
             Title="Şifre Değiştir"
             BackgroundColor="#F4F6F8">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30,50,30,30">

            <Label Text="🔒 Güvenlik Ayarları" FontSize="24" FontAttributes="Bold" TextColor="#2C3E50" HorizontalOptions="Center" Margin="0,0,0,20"/>

            <Frame HasShadow="True" CornerRadius="15" Padding="25" BackgroundColor="White" BorderColor="Transparent">
                <VerticalStackLayout Spacing="15">

                    <Border Stroke="#BDC3C7" StrokeThickness="1" BackgroundColor="#F8F9F9" Padding="10,0" >
                        <Entry x:Name="OldPasswordEntry" Placeholder="Mevcut Şifreniz" IsPassword="True" TextColor="Black" />
                    </Border>

                    <Border Stroke="#BDC3C7" StrokeThickness="1" BackgroundColor="#F8F9F9" Padding="10,0" >
                        <Entry x:Name="NewPasswordEntry" Placeholder="Yeni Şifre" IsPassword="True" TextColor="Black" />
                    </Border>

                    <Border Stroke="#BDC3C7" StrokeThickness="1" BackgroundColor="#F8F9F9" Padding="10,0" >
                        <Entry x:Name="ConfirmPasswordEntry" Placeholder="Yeni Şifre (Tekrar)" IsPassword="True" TextColor="Black" />
                    </Border>

                    <Label x:Name="MessageLabel" FontSize="12" IsVisible="False" HorizontalOptions="Center" />

                    <Button Text="Şifreyi Güncelle" BackgroundColor="#E67E22" TextColor="White" CornerRadius="10" FontAttributes="Bold" HeightRequest="50" Margin="0,15,0,0" Clicked="OnUpdatePasswordClicked" />

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>