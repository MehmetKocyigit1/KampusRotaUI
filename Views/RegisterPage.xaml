<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KampusRotaUI.Views.RegisterPage"
             BackgroundColor="{StaticResource RideSurface}"
             Title="Kayıt Ol">

    <ScrollView>
        <VerticalStackLayout Spacing="22" Padding="28,38,28,30">

            <VerticalStackLayout Spacing="6">
                <Label Text="KampüsRota'ya katıl" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource Tertiary}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Label Text="Üniversite hesabınla güvenli yolculuk paylaş." FontSize="14" TextColor="{StaticResource RideMuted}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border Padding="22" BackgroundColor="{StaticResource White}" Stroke="{StaticResource RideLine}" StrokeThickness="1" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="14">

                    <!-- Ad ve Soyad (Yan Yana) -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <Border Grid.Column="0" Stroke="{StaticResource RideLine}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Padding="12,0">
                            <Entry x:Name="NameEntry" Placeholder="Ad" TextColor="{StaticResource Tertiary}" />
                        </Border>
                        <Border Grid.Column="1" Stroke="{StaticResource RideLine}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Padding="12,0">
                            <Entry x:Name="SurnameEntry" Placeholder="Soyad" TextColor="{StaticResource Tertiary}" />
                        </Border>
                    </Grid>

                    <Border Stroke="{StaticResource RideLine}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Padding="12,0">
                        <Entry x:Name="StudentNoEntry" Placeholder="Öğrenci numarası (opsiyonel)" Keyboard="Numeric" TextColor="{StaticResource Tertiary}" />
                    </Border>

                    <!-- Kadınlara özel ilan filtresi için cinsiyet bilgisi -->
                    <Border Stroke="{StaticResource RideLine}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Padding="12,10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Cinsiyet" FontSize="13" TextColor="{StaticResource RideMuted}" />
                            <RadioButton x:Name="FemaleGenderRadio" GroupName="Gender" Content="Kadın" TextColor="{StaticResource Tertiary}" Value="Kadın" />
                            <RadioButton x:Name="MaleGenderRadio" GroupName="Gender" Content="Erkek" TextColor="{StaticResource Tertiary}" Value="Erkek" />
                            <RadioButton x:Name="UnspecifiedGenderRadio" GroupName="Gender" Content="Belirtmek istemiyorum" TextColor="{StaticResource Tertiary}" Value="Belirtmek İstemiyorum" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Stroke="{StaticResource RideLine}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Padding="12,0">
                        <Entry x:Name="EmailEntry" Placeholder="Üniversite e-postası (.edu.tr)" Keyboard="Email" TextColor="{StaticResource Tertiary}" />
                    </Border>

                    <Border Stroke="{StaticResource RideLine}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Padding="12,0">
                        <Entry x:Name="PasswordEntry" Placeholder="Şifre" IsPassword="True" TextColor="{StaticResource Tertiary}" />
                    </Border>

                    <Border Stroke="{StaticResource RideLine}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Padding="12,0">
                        <Entry x:Name="ConfirmPasswordEntry" Placeholder="Şifre tekrar" IsPassword="True" TextColor="{StaticResource Tertiary}" />
                    </Border>

                    <Button Text="Kayıt ol" BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource White}" CornerRadius="24" FontAttributes="Bold" HeightRequest="50" Margin="0,10,0,0" Clicked="OnRegisterClicked" />

                </VerticalStackLayout>
            </Border>

            <Button Text="Zaten hesabın var mı? Giriş yap" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontAttributes="Bold" Clicked="OnLoginNavClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
