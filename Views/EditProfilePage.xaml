<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KampusRotaUI.Views.EditProfilePage"
             Title="Profili Düzenle"
             NavigationPage.HasNavigationBar="False"
             Background="{StaticResource AppBackgroundBrush}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="18,20,18,28">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Text="Geri"
                        Clicked="OnBackClicked"
                        BackgroundColor="#EAF6FD"
                        BorderColor="#BDDDED"
                        BorderWidth="1"
                        TextColor="#111827"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        Padding="16,0"
                        HeightRequest="40" />

                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label Text="Profili düzenle" FontSize="23" FontAttributes="Bold" TextColor="#1D9DE5" />
                    <Label Text="İletişim ve görünür profil bilgilerini güncelle." FontSize="12" TextColor="#6B7280" />
                </VerticalStackLayout>
            </Grid>

            <Border BackgroundColor="#1D9DE5" Stroke="Transparent" StrokeShape="RoundRectangle 20" Padding="18">
                <Grid ColumnDefinitions="92,*" ColumnSpacing="14">
                    <Border Stroke="White" StrokeThickness="3" StrokeShape="RoundRectangle 42" HeightRequest="84" WidthRequest="84" BackgroundColor="#EAF6FD">
                        <Image x:Name="ProfilePreviewImage" Source="insta_male.png" Aspect="AspectFill" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Label x:Name="PreviewNameLabel" Text="Kullanıcı" FontSize="19" FontAttributes="Bold" TextColor="White" LineBreakMode="TailTruncation" />
                        <Label x:Name="PreviewEmailLabel" TextColor="#D6EEFB" FontSize="12" LineBreakMode="TailTruncation" />
                        <HorizontalStackLayout Spacing="8">
                            <Button Text="Fotoğraf"
                                    Clicked="OnChangePhotoClicked"
                                    BackgroundColor="#EAF6FD"
                                    TextColor="#111827"
                                    CornerRadius="14"
                                    FontAttributes="Bold"
                                    HeightRequest="38"
                                    Padding="14,0" />
                            <Button Text="Kaldır"
                                    Clicked="OnRemovePhotoClicked"
                                    BackgroundColor="#33FFFFFF"
                                    TextColor="White"
                                    CornerRadius="14"
                                    FontAttributes="Bold"
                                    HeightRequest="38"
                                    Padding="14,0" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border BackgroundColor="#EAF6FD" Stroke="#BDDDED" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="KİŞİSEL BİLGİLER" FontSize="12" FontAttributes="Bold" TextColor="#74777D" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Ad" FontSize="12" FontAttributes="Bold" TextColor="#74777D" />
                            <Border Stroke="#BDDDED" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#EAF6FD" Padding="12,0" HeightRequest="52">
                                <Entry x:Name="NameEntry" Placeholder="Ad" TextColor="#111827" PlaceholderColor="#9CA3AF" TextChanged="OnNameTextChanged" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Soyad" FontSize="12" FontAttributes="Bold" TextColor="#74777D" />
                            <Border Stroke="#BDDDED" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#EAF6FD" Padding="12,0" HeightRequest="52">
                                <Entry x:Name="SurnameEntry" Placeholder="Soyad" TextColor="#111827" PlaceholderColor="#9CA3AF" TextChanged="OnNameTextChanged" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Telefon" FontSize="12" FontAttributes="Bold" TextColor="#74777D" />
                        <Border Stroke="#BDDDED" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#EAF6FD" Padding="12,0" HeightRequest="52">
                            <Entry x:Name="PhoneEntry" Placeholder="05XX XXX XX XX" Keyboard="Telephone" TextColor="#111827" PlaceholderColor="#9CA3AF" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Cinsiyet" FontSize="12" FontAttributes="Bold" TextColor="#74777D" />
                        <Border Stroke="#BDDDED" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#EAF6FD" Padding="12,0" HeightRequest="52">
                            <Picker x:Name="GenderPicker" TextColor="#111827">
                                <Picker.Items>
                                    <x:String>Erkek</x:String>
                                    <x:String>Kadın</x:String>
                                    <x:String>Belirtmek İstemiyorum</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#EAF6FD" Stroke="#BDDDED" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="BİYOGRAFİ" FontSize="12" FontAttributes="Bold" TextColor="#74777D" />
                        <Label x:Name="BioCounterLabel" Grid.Column="1" Text="0/250" FontSize="12" FontAttributes="Bold" TextColor="#74777D" />
                    </Grid>

                    <Border Stroke="#BDDDED" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#EAF6FD" Padding="12,8">
                        <Editor x:Name="BioEditor"
                                Placeholder="Kısa bir tanıtım, sürüş tarzın veya yolculuk notların..."
                                HeightRequest="112"
                                TextColor="#111827"
                                PlaceholderColor="#9CA3AF"
                                TextChanged="OnBioTextChanged" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#EAF6FD" Stroke="#BDDDED" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="HESAP BİLGİLERİ" FontSize="12" FontAttributes="Bold" TextColor="#74777D" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Okul e-postası" FontSize="12" FontAttributes="Bold" TextColor="#74777D" />
                        <Label x:Name="EmailValueLabel" FontSize="14" TextColor="#111827" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#CFEAFF" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Öğrenci numarası" FontSize="12" FontAttributes="Bold" TextColor="#74777D" />
                        <Label x:Name="StudentNoValueLabel" FontSize="14" TextColor="#111827" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label x:Name="MessageLabel"
                   IsVisible="False"
                   FontSize="12"
                   HorizontalTextAlignment="Center" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Vazgeç"
                        Clicked="OnBackClicked"
                        BackgroundColor="#EAF6FD"
                        BorderColor="#BDDDED"
                        BorderWidth="1"
                        TextColor="#111827"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        HeightRequest="50" />

                <Button x:Name="SaveButton"
                        Grid.Column="1"
                        Text="Kaydet"
                        Clicked="OnSaveClicked"
                        BackgroundColor="#1D9DE5"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        HeightRequest="50" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
