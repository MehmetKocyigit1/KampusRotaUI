<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KampusRotaUI.Views.MapPage"
             Title="Harita"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <WebView x:Name="MapWebView" HorizontalOptions="Fill" VerticalOptions="Fill" />

         <!--Small overlay for JS logs / errors--> 
        <Frame BackgroundColor="#80000000" Padding="8" CornerRadius="8" HasShadow="False" HorizontalOptions="End" VerticalOptions="Start" Margin="12">
            <Label x:Name="JsLogLabel" TextColor="White" FontSize="12" MaxLines="3" LineBreakMode="TailTruncation" />
        </Frame>
    </Grid>
</ContentPage>