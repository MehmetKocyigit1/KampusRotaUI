<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KampusRotaUI.Views.MainPage"
             Title="Kampüs Rotaları"
             BackgroundColor="{StaticResource RideSurface}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Çıkış" Clicked="OnLogoutClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, *">

        <Border Grid.Row="0"
                Margin="18,16,18,10"
                Padding="18"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource RideLine}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18">
            <VerticalStackLayout Spacing="14">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Nereye gidiyorsun?"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Tertiary}" />
                    <Label Text="Kampüs çevresindeki uygun yolculukları bul."
                           FontSize="13"
                           TextColor="{StaticResource RideMuted}" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="10">
                        <Border Stroke="{StaticResource RideLine}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Padding="12,0">
                            <Picker x:Name="StartPicker" Title="Kalkış noktası" FontSize="14" TextColor="{StaticResource Tertiary}" TitleColor="{StaticResource RideMuted}">
                                <Picker.Items>
                                    <x:String>Iyaş</x:String>
                                    <x:String>Doğu Kampüsü</x:String>
                                    <x:String>Batı Kampüsü</x:String>
                                    <x:String>100. Yıl Yerleşkesi</x:String>
                                    <x:String>Erkek Yurdu</x:String>
                                    <x:String>MihriHatun Kız Yurdu</x:String>
                                    <x:String>Şehir Merkezi (Meydan)</x:String>
                                    <x:String>Otogar</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>

                        <Border Stroke="{StaticResource RideLine}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FBFEFE" Padding="12,0">
                            <DatePicker x:Name="RideDate" Format="dd MMM" FontSize="14" TextColor="{StaticResource Tertiary}" />
                        </Border>
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="Ara"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            CornerRadius="24"
                            Clicked="OnSearchClicked"
                            WidthRequest="72"
                            HeightRequest="96"
                            VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,6,18,22" Spacing="12">
                <Grid ColumnDefinitions="*, Auto" Margin="0,2,0,2">
                    <Label Grid.Column="0" Text="Mevcut Yolculuklar" FontAttributes="Bold" FontSize="19" TextColor="{StaticResource Tertiary}" />
                    <Label Grid.Column="1" Text="KampüsRota" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                </Grid>
                <CollectionView x:Name="RidesCollection">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,5"
                                    Padding="16"
                                    BackgroundColor="{StaticResource White}"
                                    Stroke="{StaticResource RideLine}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16">
                                <Grid ColumnDefinitions="16, *, Auto" ColumnSpacing="14" RowDefinitions="Auto, Auto, Auto">
                                    <Grid Grid.Column="0" Grid.RowSpan="2" RowDefinitions="14, *, 14" WidthRequest="16">
                                        <Border Grid.Row="0" BackgroundColor="{StaticResource Primary}" Stroke="Transparent" StrokeShape="RoundRectangle 6" HeightRequest="12" WidthRequest="12" HorizontalOptions="Center" />
                                        <BoxView Grid.Row="1" WidthRequest="2" BackgroundColor="{StaticResource RideLine}" HorizontalOptions="Center" />
                                        <Border Grid.Row="2" BackgroundColor="{StaticResource Tertiary}" Stroke="Transparent" StrokeShape="RoundRectangle 6" HeightRequest="12" WidthRequest="12" HorizontalOptions="Center" />
                                    </Grid>

                                    <VerticalStackLayout Grid.Column="1" Grid.Row="0" Spacing="5">
                                        <Label Text="{Binding Rota}" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource Tertiary}" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Surucu.TamAd, StringFormat='Sürücü: {0}'}" FontSize="13" TextColor="{StaticResource RideMuted}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" Grid.Row="0" VerticalOptions="Start" HorizontalOptions="End" Spacing="3">
                                        <Label Text="{Binding UcretMetni}" TextColor="{StaticResource Tertiary}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                        <Label Text="{Binding BosKoltukSayisi, StringFormat='{0} koltuk'}" TextColor="{StaticResource RideMuted}" FontSize="12" HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>

                                    <HorizontalStackLayout Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Spacing="8" Margin="0,12,0,0">
                                        <Border Stroke="Transparent" BackgroundColor="{StaticResource Secondary}" StrokeShape="RoundRectangle 12" Padding="10,5">
                                            <Label Text="{Binding TarihFormatli}" FontSize="12" TextColor="{StaticResource SecondaryDarkText}" FontAttributes="Bold" />
                                        </Border>
                                        <Border Stroke="Transparent" BackgroundColor="#F4ECFA" StrokeShape="RoundRectangle 12" Padding="10,5" IsVisible="{Binding SadeceKadinlarMi}">
                                            <Label Text="{Binding KadinaOzelMetni}" FontSize="12" TextColor="#7B3FA0" FontAttributes="Bold" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" Spacing="8" Margin="0,12,0,0" HorizontalOptions="End">
                                        <Button Text="Düzenle"
                                                BackgroundColor="#EEF5FF"
                                                TextColor="{StaticResource Primary}"
                                                CornerRadius="16"
                                                FontSize="12"
                                                Padding="14,5"
                                                HeightRequest="34"
                                                Clicked="OnEditRideClicked" />
                                        <Button Text="Sil"
                                                BackgroundColor="#FDECEC"
                                                TextColor="#C62828"
                                                CornerRadius="16"
                                                FontSize="12"
                                                Padding="14,5"
                                                HeightRequest="34"
                                                Clicked="OnDeleteRideClicked" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
